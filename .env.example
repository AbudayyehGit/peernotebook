# AI Studio Environment Configuration
DISABLE_HMR=false
GEMINI_API_KEY=

# Resend Transactional Email Gateway
# Obtain production API key from https://resend.com/api-keys
RESEND_API_KEY=re_1234567890abcdef

# Configured sender address (must match verified domain in resend.com/domains)
# Default: Peer Notebook <notifications@peernotebook.com>
# Fallback during initial domain verification: Peer Notebook <onboarding@resend.dev>
RESEND_FROM_EMAIL=Peer Notebook <notifications@peernotebook.com>

# Administrative and Lead Digest Target Email
SUPPORT_EMAIL=support@peernotebook.com

# Supabase Storage & Authentication
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Billing & Free Trial Architecture
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
