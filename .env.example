# AI Studio Environment Configuration
DISABLE_HMR=false

# Brevo REST API v3 & Transactional Email Gateway
# Endpoint: https://api.brevo.com/v3/smtp/email
# Headers: { "accept": "application/json", "content-type": "application/json", "api-key": "xkeysib-..." }
BREVO_API_KEY=your-brevo-api-key-here
BREVO_FROM_EMAIL=support@peernotebook.com
BREVO_FROM_NAME=Peer Notebook

# Brevo SMTP Relay Fallback (Host: smtp-relay.brevo.com | Port: 587 STARTTLS)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=joeabudayyeh@gmail.com
BREVO_SMTP_PASS=your-brevo-smtp-password

# Administrative and Lead Digest Target Inboxes
SUPPORT_EMAIL=support@peernotebook.com
ADMIN_INBOX=joeabudayyeh@gmail.com

# Resend Transactional Email Gateway (Secondary / Fallback)
# Obtain production API key from https://resend.com/api-keys
RESEND_API_KEY=re_1234567890abcdef
RESEND_FROM_EMAIL=Peer Notebook <support@peernotebook.com>

# Supabase Storage & Authentication
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Billing & Free Trial Architecture
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
